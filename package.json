    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
